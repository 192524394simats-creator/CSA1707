      "source": [
        "\n",
        "# Minimax Algorithm for Gaming\n",
        "\n",
        "def minimax(depth, node, is_maximizing, scores):\n",
        "    # If leaf node is reached\n",
        "    if depth == 3:\n",
        "        return scores[node]\n",
        "\n",
        "    if is_maximizing:\n",
        "        best = float('-inf')\n",
        "\n",
        "        for i in range(2):\n",
        "            value = minimax(depth + 1, node * 2 + i,\n",
        "                            False, scores)\n",
        "            best = max(best, value)\n",
        "\n",
        "        return best\n",
        "\n",
        "    else:\n",
        "        best = float('inf')\n",
        "\n",
        "        for i in range(2):\n",
        "            value = minimax(depth + 1, node * 2 + i,\n",
        "                            True, scores)\n",
        "            best = min(best, value)\n",
        "\n",
        "        return best\n",
        "\n",
        "\n",
        "# Leaf node values\n",
        "scores = [3, 5, 2, 9, 12, 5, 23, 23]\n",
        "\n",
        "# Find the best value\n",
        "result = minimax(0, 0, True, scores)\n",
        "\n",
        "print(\"The optimal value is:\", result)\n",
        "\n"
      ]
    }
