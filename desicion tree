      "source": [
        "\n",
        "# Decision Tree Classification\n",
        "\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "\n",
        "# Training data\n",
        "X = [[1, 1],\n",
        "     [1, 0],\n",
        "     [0, 1],\n",
        "     [0, 0]]\n",
        "\n",
        "# Output labels\n",
        "y = [1, 1, 0, 0]\n",
        "\n",
        "# Create Decision Tree model\n",
        "model = DecisionTreeClassifier()\n",
        "\n",
        "# Train the model\n",
        "model.fit(X, y)\n",
        "\n",
        "# Predict the output\n",
        "prediction = model.predict([[1, 1]])\n",
        "\n",
        "print(\"Predicted Output:\", prediction[0])\n",
        "\n"
      ]
    }
