      "source": [
        "\n",
        "# Map Coloring Problem using CSP\n",
        "\n",
        "# Define the map regions and their neighbors\n",
        "regions = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['A', 'C', 'D'],\n",
        "    'C': ['A', 'B', 'D'],\n",
        "    'D': ['B', 'C']\n",
        "}\n",
        "\n",
        "# Available colors\n",
        "colors = ['Red', 'Green', 'Blue']\n",
        "\n",
        "# Store the assigned colors\n",
        "color_assignment = {}\n",
        "\n",
        "# Check whether a color is valid for a region\n",
        "def is_valid(region, color):\n",
        "    for neighbor in regions[region]:\n",
        "        if neighbor in color_assignment:\n",
        "            if color_assignment[neighbor] == color:\n",
        "                return False\n",
        "    return True\n",
        "\n",
        "# Backtracking algorithm\n",
        "def map_coloring():\n",
        "    if len(color_assignment) == len(regions):\n",
        "        return True\n",
        "\n",
        "    # Select an uncolored region\n",
        "    region = next(r for r in regions if r not in color_assignment)\n",
        "\n",
        "    # Try each available color\n",
        "    for color in colors:\n",
        "        if is_valid(region, color):\n",
        "            color_assignment[region] = color\n",
        "\n",
        "            if map_coloring():\n",
        "                return True\n",
        "\n",
        "            # Backtrack if the assignment fails\n",
        "            del color_assignment[region]\n",
        "\n",
        "    return False\n",
        "\n",
        "# Display the result\n",
        "if map_coloring():\n",
        "    print(\"Map Coloring Solution:\")\n",
        "    for region, color in color_assignment.items():\n",
        "        print(region, \":\", color)\n",
        "else:\n",
        "    print(\"No solution exists.\")"
      ]
    }
