      "source": [
        "\n",
        "# Alpha-Beta Pruning Algorithm\n",
        "\n",
        "def alphabeta(depth, node, is_maximizing, scores, alpha, beta):\n",
        "\n",
        "    # If leaf node is reached\n",
        "    if depth == 3:\n",
        "        return scores[node]\n",
        "\n",
        "    if is_maximizing:\n",
        "        best = float('-inf')\n",
        "\n",
        "        for i in range(2):\n",
        "            value = alphabeta(depth + 1, node * 2 + i,\n",
        "                              False, scores, alpha, beta)\n",
        "\n",
        "            best = max(best, value)\n",
        "            alpha = max(alpha, best)\n",
        "\n",
        "            # Beta pruning\n",
        "            if beta <= alpha:\n",
        "                break\n",
        "\n",
        "        return best\n",
        "\n",
        "    else:\n",
        "        best = float('inf')\n",
        "\n",
        "        for i in range(2):\n",
        "            value = alphabeta(depth + 1, node * 2 + i,\n",
        "                              True, scores, alpha, beta)\n",
        "\n",
        "            best = min(best, value)\n",
        "            beta = min(beta, best)\n",
        "\n",
        "            # Alpha pruning\n",
        "            if beta <= alpha:\n",
        "                break\n",
        "\n",
        "        return best\n",
        "\n",
        "\n",
        "# Leaf node values\n",
        "scores = [3, 5, 2, 9, 12, 5, 23, 23]\n",
        "\n",
        "# Initial alpha and beta values\n",
        "alpha = float('-inf')\n",
        "beta = float('inf')\n",
        "\n",
        "# Find the optimal value\n",
        "result = alphabeta(0, 0, True, scores, alpha, beta)\n",
        "\n",
        "print(\"The optimal value is:\", result)\n",
        "\n",
        "\n"
      ]
    }
