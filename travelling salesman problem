      "source": [
        "\n",
        "from itertools import permutations\n",
        "\n",
        "def tsp(graph, start):\n",
        "    cities = list(range(len(graph)))\n",
        "    cities.remove(start)\n",
        "\n",
        "    min_cost = float('inf')\n",
        "    best_path = []\n",
        "\n",
        "    for path in permutations(cities):\n",
        "        route = [start] + list(path) + [start]\n",
        "\n",
        "        cost = 0\n",
        "        for i in range(len(route) - 1):\n",
        "            cost += graph[route[i]][route[i + 1]]\n",
        "\n",
        "        if cost < min_cost:\n",
        "            min_cost = cost\n",
        "            best_path = route\n",
        "\n",
        "    print(\"Shortest Path:\", \" -> \".join(map(str, best_path)))\n",
        "    print(\"Minimum Cost:\", min_cost)\n",
        "\n",
        "\n",
        "# Distance matrix\n",
        "graph = [\n",
        "    [0, 10, 15, 20],\n",
        "    [10, 0, 35, 25],\n",
        "    [15, 35, 0, 30],\n",
        "    [20, 25, 30, 0]\n",
        "]\n",
        "\n",
        "tsp(graph, 0)\n"
      ]
    }
