        "\n",
        "\n",
        "# Feed Forward Neural Network\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "# Input data\n",
        "inputs = np.array([1, 0])\n",
        "\n",
        "# Weights and biases\n",
        "weights = np.array([[0.5, 0.2],\n",
        "                    [0.3, 0.4]])\n",
        "\n",
        "bias = np.array([0.1, 0.2])\n",
        "\n",
        "# Hidden layer calculation\n",
        "hidden = np.dot(weights, inputs) + bias\n",
        "\n",
        "# ReLU activation function\n",
        "hidden_output = np.maximum(0, hidden)\n",
        "\n",
        "# Output layer weights and bias\n",
        "output_weights = np.array([0.6, 0.7])\n",
        "output_bias = 0.1\n",
        "\n",
        "# Output layer calculation\n",
        "output = np.dot(output_weights, hidden_output) + output_bias\n",
        "\n",
        "# Display result\n",
        "print(\"Input:\", inputs)\n",
        "print(\"Hidden Layer Output:\", hidden_output)\n",
        "print(\"Network Output:\", output)\n",
        "\n"
      ]
    }
